@ARTICLE{2001PhRvE..65a6120C,
       author = {{Cartin}, Daniel and {Khanna}, Gaurav},
        title = "{Self-regulated model of galactic spiral structure formation}",
      journal = {Physical Review E},
     keywords = {82.40.Ck, 05.65.+b, 89.75.Fb, Pattern formation in reactions with diffusion flow and heat transfer, Self-organized systems, Structures and organization in complex systems, Astrophysics, Nonlinear Sciences - Adaptation and Self-Organizing Systems},
         year = 2001,
        month = dec,
       volume = {65},
       number = {1},
          eid = {016120},
        pages = {016120},
     abstract = "{The presence of spiral structure in isolated galaxies is a problem that
        has only been partially explained by theoretical models. Because
        the rate and pattern of star formation in the disk must depend
        only on mechanisms internal to the disk, we may think of the
        spiral galaxy as a self-regulated system far from equilibrium.
        This paper uses this idea to look at a reaction-diffusion model
        for the formation of spiral structures in certain types of
        galaxies. In numerical runs of the model, spiral structure forms
        and persists over several revolutions of the disk, but
        eventually dies out.}",
          doi = {10.1103/PhysRevE.65.016120},
