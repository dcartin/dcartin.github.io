     keywords = {04.60.Pp, 04.60.Kz, 98.80.Qc, Loop quantum gravity quantum geometry spin foams, Lower dimensional models, minisuperspace models, Quantum cosmology, General Relativity and Quantum Cosmology, High Energy Physics - Theory},
         year = 2006,
